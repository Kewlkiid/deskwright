# Meta Model API (OpenAI-SDK compatible). Never commit a real key.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1

# Per-role model overrides
PLANNER_MODEL=muse-wonder-1.0
VISION_MODEL=muse-spark-1.3
GROUNDING_MODEL=sam-3.1
VOICE_MODEL=muse-voice-transcribe-1.0

# 1 = run with deterministic offline fakes instead of real model calls
AGENT_FAKE_MODELS=0

# Optional: approximate USD per 1M tokens, for the metrics panel
PRICE_IN_PER_M=1.0
PRICE_OUT_PER_M=4.0
PRICE_PER_GROUNDING_CALL=0.002

# Meta (Llama) API key, for when the engine switches from OpenRouter to the Meta API.
META_API_KEY=
